# ---------------------------------------------------------------------------
# Developer Mission Control — example environment
# ---------------------------------------------------------------------------
# Everything is optional. With no .env file at all the shell runs entirely on
# bundled mock data, so `npm run dev` renders the full dashboard immediately.

# Build identifier baked into the client bundle. CI normally injects a commit
# SHA here; locally it falls back to a timestamp.
NEXT_PUBLIC_BUILD_ID=

# ---------------------------------------------------------------------------
# Optional: point the shell at your own JSON feeds
# ---------------------------------------------------------------------------
# Any absolute or relative URL returning the documented payload shape works.
# Leave blank to use config/mockData.ts.
NEXT_PUBLIC_SPRINT_ENDPOINT=
NEXT_PUBLIC_REPORTS_ENDPOINT=
NEXT_PUBLIC_INTELLIGENCE_ENDPOINT=
NEXT_PUBLIC_FINOPS_ENDPOINT=
NEXT_PUBLIC_TASKS_ENDPOINT=

# ---------------------------------------------------------------------------
# Optional: auth provider seam
# ---------------------------------------------------------------------------
# The template ships with a local mock session (see
# components/providers/workspace-auth-provider.tsx). Add your own provider
# credentials here when you replace it.
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
